            {
              "id": "open-btn",
              "type": "button",
              "props": {
                "text": "Open"
              },
              "style": {}
            },
            {
              "id": "modal1",
              "type": "modal",
              "props": {
                "hidden": true
              },
              "style": {},
              "children": [
                {
                  "id": "mp",
                  "type": "paragraph",
                  "props": {
                    "text": "Pop-up text"
                  },
                  "style": {}
                }
              ]
            }
          ]
        },
        "interactions": [
          {
            "id": "i-open",
            "targetId": "open-btn",
            "trigger": {
              "type": "clicked"
            },
            "actions": [
              {
                "type": "show",
                "params": {
                  "targetId": "modal1"
                }
              }
            ]
          }
        ]
