    "pages": [
      {
        "id": "home",
        "name": "Home",
        "path": "index",
        "title": "Fixture home",
        "isHome": true,
        "root": {
          "id": "root",
          "type": "section",
          "props": {},
          "style": {},
          "children": [
            {
              "id": "h1",
              "type": "heading",
              "props": {
                "level": 1,
                "text": "Components test"
              },
              "style": {}
            },
            {
              "id": "cols",
              "type": "columns",
              "props": {},
              "style": {},
              "children": [
                {
                  "id": "pl",
                  "type": "paragraph",
                  "props": {
                    "text": "Left"
                  },
                  "style": {}
                },
                {
                  "id": "pr",
                  "type": "paragraph",
                  "props": {
                    "text": "Right"
                  },
                  "style": {}
                }
              ]
            },
            {
              "id": "dd",
              "type": "dropdown",
              "props": {
                "options": [
                  "Red",
                  "Blue"
                ]
              },
              "style": {}
            },
            {
              "id": "ls",
              "type": "list",
              "props": {
                "items": [
                  "one",
                  "two"
                ]
              },
              "style": {}
            },
            {
              "id": "ta",
              "type": "textArea",
              "props": {
                "placeholder": "Write here"
              },
              "style": {}
            },
            {
              "id": "nv",
              "type": "navigation",
              "props": {},
              "style": {},
              "children": [
                {
                  "id": "nl",
                  "type": "link",
                  "props": {
                    "text": "Other page",
                    "pageId": "about"
                  },
                  "style": {}
                }
              ]
            },
            {
              "id": "yt",
              "type": "youtube",
              "props": {
                "youtubeId": "dQw4w9WgXcQ"
              },
              "style": {}
            },
            {
              "id": "yt-bad",
              "type": "youtube",
              "props": {
                "youtubeId": "<script>alert(1)</script>"
